# Backend environment variables — copy to backend/.env for local dev.
# On Render, set these in the Environment Variables panel instead.
# NEVER commit this file with real values.

# Admin security passkey (for the PasskeyModal gate)
SECURITY_LOG_PASSKEY=change_this_value

# Gov/elevated-access key (used by /auth/verify-gov endpoint)
# Also used as FLOWCHAT_SECURITY_KEY on Render
FLOWCHAT_SECURITY_KEY=change_this_value

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_value

# Groq AI API key
GROQ_API_KEY=change_this_value

# CORS: comma-separated list of allowed origins
# Local dev: keep as-is. Production: set to your Netlify URL.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database URL — leave blank to use SQLite (default for local dev)
# For production on Render, set to your PostgreSQL URL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=
